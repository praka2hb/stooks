# Copy to .env.local and fill in after running contracts/script/Deploy.s.sol.
# With NEXT_PUBLIC_FACTORY empty, the app runs in demo mode on sample data.
NEXT_PUBLIC_CHAIN_ID=8453
# mainnet.base.org rate-limits browsers and log queries; publicnode allows full-range eth_getLogs. For real traffic use a
# keyed RPC (Alchemy, QuickNode, Coinbase CDP) restricted to your domain, since NEXT_PUBLIC_ values ship to the browser.
NEXT_PUBLIC_RPC_URL=https://base-rpc.publicnode.com
NEXT_PUBLIC_POOL_MANAGER=0x498581fF718922c3f8e6A244956aF099B2652b2b
NEXT_PUBLIC_FACTORY=
NEXT_PUBLIC_HOOK=
NEXT_PUBLIC_ROUTER=
NEXT_PUBLIC_ORACLE=
NEXT_PUBLIC_CLOCK=
NEXT_PUBLIC_EARNINGS=
# Block the contracts were deployed in (speeds up event queries).
NEXT_PUBLIC_DEPLOY_BLOCK=0
# Local rehearsal only (RPC must be localhost): anvil's public test key instead of a browser wallet.
NEXT_PUBLIC_DEV_KEY=

# Buy/sell with USDC in one transaction (StockHooksZap). Leave empty to trade in the paired stock only.
NEXT_PUBLIC_ZAP=
